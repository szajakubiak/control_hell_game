-->8
--init
function _init()
	--controls map
	ctrls={
		l=⬅️,
		r=➡️,
		u=⬆️,
		d=⬇️,
	}
	--player sprite
	pspr=1
	--player position
	ppos={x=60,y=60}
	
	--target sprite
	tspr=3
	--target position
	tpos={x=90,y=90}
	
	rot=flr(rnd(3))
	if rot>0 then
		for i=1,rot do
			rotate_ctrls_cws()
		end
	end
end

-->8
--update
function _update()
	if btn(ctrls.l) then
		ppos.x-=1
	end
	if btn(ctrls.r) then
		ppos.x+=1
	end
	if btn(ctrls.u) then
		ppos.y-=1
	end
	if btn(ctrls.d) then
		ppos.y+=1
	end
end

--rotate controls clockwise
function rotate_ctrls_cws()
	local temp_ctrls={}
	
	temp_ctrls.l=ctrls.u
	temp_ctrls.r=ctrls.d
	temp_ctrls.u=ctrls.r
	temp_ctrls.d=ctrls.l

	ctrls=temp_ctrls
end
-->8
--draw
function _draw()
	cls()
	
	--draw target
	spr(tspr,tpos.x,tpos.y)
	
	--draw player
	spr(pspr,ppos.x,ppos.y)
	
	print(rot,8,8,7)
end

