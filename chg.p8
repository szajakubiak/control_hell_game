-->8
--init
function _init()
	--controls map
	ctrls={
		l=⬅️,
		r=➡️,
		u=⬆️,
		d=⬇️,
	}
	--player sprite
	pspr=1
	--player position
	ppos={x=60,y=60}
end

-->8
--update
function _update()
	if btn(ctrls.l) then
		ppos.x-=1
	end
	if btn(ctrls.r) then
		ppos.x+=1
	end
	if btn(ctrls.u) then
		ppos.y-=1
	end
	if btn(ctrls.d) then
		ppos.y+=1
	end
end

-->8
--draw
function _draw()
	cls()
	spr(pspr,ppos.x,ppos.y)
end

